tomcat:
 {
    agent any

    environment {
        TOMCAT_HOME = "C:/Program Files/Apache Software Foundation/Tomcat 9.0"
    }

    stages {
        stage('Checkout') {
            steps {
                // Clone your GitHub repo
                git branch: 'master', url: 'https://github.com/suryaakshaya/mavenweb.git'
            }
        }

        stage('Build') {
            steps {
                // Run Maven build
                bat 'mvn clean package'
            }
        }

        stage('Deploy to Tomcat') {
            steps {
                // Copy WAR file to Tomcat webapps folder
                bat "copy target\\mavenweb.war \"${TOMCAT_HOME}\\webapps\\\""
            }
        }

        stage('Start Tomcat') {
            steps {
                // Start Tomcat server
                bat "\"${TOMCAT_HOME}\\bin\\startup.bat\""
            }
        }

        stage('Verify Deployment') {
            steps {
                echo 'Application deployed! Open http://localhost:8080/mavenweb'
            }
        }
    }

    post {
        always {
            echo 'Pipeline finished!'
        }
    }
}



Build and package a java and web application on maven
File -> new -> maven project-> filter(maven-archetypr-quickstart)->groupid(org.ex1)->artifactid->finish->console->y(build success)->src/main/java/App.java(write code) run as maven build(clean install test)->run as java app
right click folder->show in local terminal->open in bash->git init->git remote add cccc->git add .->git commit -m "c" -> git branch -M main->git push origin main
Web: file->new->project->maven project->filter (org.apache.maven.archetypes-webapp)->groupid->Artifactid->finish->console->y->index.jsp->window->view as->servers->add server->select tomcat 4.9.0->next->configure server options->ports(5050),loc->(tomcat folder)
index.jsp->run as server-> ->show in local terminal->open in bash->git init ->git remote ass ->All same
git init->git add .->git commit -m "c"->git branch -M main->git push 
