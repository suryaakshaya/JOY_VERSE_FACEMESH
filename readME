docker:
ubuntu: docker pull ubuntu:latest->docker run -it -p 9090:90 --name myubuntu1 ubuntu:latest 
nginx: docker run -d -p 9090:80 --name mynginx nginx (localhost:9090)
nagios: docker run -d -p 8090:80 --name mynagios jasonrivers/nagios:latest (nagiosadmin,nagios)




creating image in docker:
run existing container: docker start myubuntu2 -> docker exec -it myubuntu2 bash->docker commit ubuntu-commit-1 img-commit-1->docker images->docker run -it img-commit-1->docker tag img-commit-1 surya/img-commit-1->docker push surya/img-commit-1



mkdir image-creation->cd image-creation->notepad Dockerfile->rename Dockerfile.txt Dockerfile->
FROM nginx
COPY . /usr/share/nginx/html
->docker build -t mysite .->docker run -d -p 9090:80 mysite


two containers parallelrly->docker run -d -p 8010:80 nginx;docker run -d --name web2 -p 9002:80 httpd
using docekr-compose : mkdir docker-compose -> cd docker-compose->  notepad docker-compose.yml
version: '3.9'

services:
  web1:
    image: nginx
    ports:
      - "9001:80"

  web2:
    image: httpd
    ports:
      - "9002:80"
->docker-compose up -d->docker compose up -d

word press: mkdir wordpress -> notepad docker-compose.yml:
version: '3.9'

services:
  db:
    image: mysql:5.7
    container_name: wordpress_db
    restart: always
    environment:
      MYSQL_ROOT_PASSWORD: root
      MYSQL_DATABASE: wordpress
      MYSQL_USER: wpuser
      MYSQL_PASSWORD: wppassword
    volumes:
      - db_data:/var/lib/mysql

  wordpress:
    image: wordpress:latest
    container_name: wordpress_app
    restart: always
    ports:
      - "8082:80"
    environment:
      WORDPRESS_DB_HOST: db:3306
      WORDPRESS_DB_USER: wpuser
      WORDPRESS_DB_PASSWORD: wppassword
      WORDPRESS_DB_NAME: wordpress
    volumes:
      - wordpress_data:/var/www/html

volumes:
  db_data:
  wordpress_data:
docker-compose up -d->localhost
