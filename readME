two containers parallelrly->docker run -d -p 8010:80 nginx;docker run -d --name web2 -p 9002:80 httpd
using docekr-compose : mkdir docker-compose -> cd docker-compose->  notepad docker-compose.yml
version: '3.9'

services:
  web1:
    image: nginx
    ports:
      - "9001:80"

  web2:
    image: httpd
    ports:
      - "9002:80"
->docker-compose up -d->docker compose up -d

word press: mkdir wordpress -> notepad docker-compose.yml:
version: '3.9'

services:
  db:
    image: mysql:5.7
    container_name: wordpress_db
    restart: always
    environment:
      MYSQL_ROOT_PASSWORD: root
      MYSQL_DATABASE: wordpress
      MYSQL_USER: wpuser
      MYSQL_PASSWORD: wppassword
    volumes:
      - db_data:/var/lib/mysql

  wordpress:
    image: wordpress:latest
    container_name: wordpress_app
    restart: always
    ports:
      - "8082:80"
    environment:
      WORDPRESS_DB_HOST: db:3306
      WORDPRESS_DB_USER: wpuser
      WORDPRESS_DB_PASSWORD: wppassword
      WORDPRESS_DB_NAME: wordpress
    volumes:
      - wordpress_data:/var/www/html

volumes:
  db_data:
  wordpress_data:
docker-compose up -d->localhost


Maven-web-pipeline
pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                git url: 'https://github.com/your-repo', branch: 'main'
            }
        }

        stage('Test') {
            steps {
                sh 'mvn clean test'
            }
        }

        stage('Test Report') {
            steps {
                junit '**/target/surefire-reports/*.xml'
            }
        }
    }
}


pipeline view for maven web:

build:
new->freestyle->maven_web_build->In the source code management select git and give the git repo link->build steps(invoke) clean install,->post build (archive art) **/*,buiild other maven_web_test
test:
new->freestyle->maven_web_test->src code->none->env(del work)->build steps(copy art)maven_web_test,**/* , (invoke top level) test->post build(arc art) **/*, build other maven_Web_deploy
deploy:
new->freestyle->maven_web_deploy->src none->env del work->build step (copy art)maven_web_test**/*
pipeline: new view ->maven_web_build(directly) ->save run 
